<h2>1. Document Information</h2>
<table>
  <tr><th>Field</th><th>Details</th></tr>
  <tr><td>Product Name</td><td>Fitma.ai</td></tr>
  <tr><td>AI Assistant</td><td>Liva</td></tr>
