# Frontend Environment Variables
VITE_API_URL=http://localhost:5000

# Backend Environment Variables
PORT=5000
FIREBASE_DATABASE_URL=https://fitma-ai-default-rtdb.firebaseio.com

# Firebase Service Account Key
# Locally: Provide the path to your downloaded JSON key file (e.g., ./backend/firebase-key.json)
# Production (Vercel): Provide the compressed/minified JSON string directly in the Vercel Dashboard
FIREBASE_SERVICE_ACCOUNT_KEY=./backend/firebase-key.json
