{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://fitma-ai.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/notifications/cron/evaluate",
      "schedule": "0 0 * * *"
    }
  ]
}
